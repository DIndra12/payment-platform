    {
      "name": "10 End-to-End Payment Flow",
      "item": [
        {
          "name": "1. Check Initial Balances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/accounts/{{account_id_1}}/balance",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "accounts", "{{account_id_1}}", "balance"]
            },
            "description": "Step 1: Check initial balance of account 1"
          }
        },
        {
          "name": "2. Create Payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerAccountId\": \"{{account_id_1}}\",\n  \"payeeAccountId\": \"{{account_id_2}}\",\n  \"amount\": 25.00,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/payments",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "payments"]
            },
            "description": "Step 2: Create payment from account 1 to account 2. Save the payment ID from response."
          }
        },
        {
          "name": "3. Check Payment Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/payments/{{payment_id}}",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "payments", "{{payment_id}}"]
            },
            "description": "Step 3: Check payment status. Replace {{payment_id}} with actual ID."
          }
        },
        {
          "name": "4. Check Final Balances",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/accounts/{{account_id_1}}/balance",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "accounts", "{{account_id_1}}", "balance"]
            },
            "description": "Step 4: Check final balance (should be reduced by payment amount)"
          }
        },
        {
          "name": "5. View Transaction History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {

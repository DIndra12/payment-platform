    {
      "name": "06 Rate Limiting Tests",
      "item": [
        {
          "name": "Rapid Fire Requests (Test Rate Limit)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This is informational - run this multiple times to test rate limiting",
                  "pm.test('Note: Run this request rapidly (100+ times) to trigger rate limit', function() {",
                  "    if (pm.response.code === 429) {",
                  "        pm.test('Rate limit triggered (429)', function() {",
                  "            pm.expect(pm.response.code).to.equal(429);",
                  "        });",
                  "    } else {",
                  "        pm.test('Request allowed', function() {",
                  "            pm.expect([200, 201]).to.include(pm.response.code);",
                  "        });",
                  "    }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/accounts/{{account_id_1}}/balance",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "accounts", "{{account_id_1}}", "balance"]
            },
            "description": "Rate limit: 100 requests per minute per user.\nRun this request 100+ times rapidly to see 429 Too Many Requests.\nWait 60 seconds for rate limit to reset."
          }
        },
        {
          "name": "Check Retry-After Header",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 429) {",
                  "    pm.test('Retry-After header present', function() {",
                  "        pm.expect(pm.response.headers.get('Retry-After')).to.exist;",
                  "    });",
                  "    ",
                  "    pm.test('Retry-After is 60 seconds', function() {",
                  "        pm.expect(pm.response.headers.get('Retry-After')).to.equal('60');",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/accounts/{{account_id_1}}/balance",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "accounts", "{{account_id_1}}", "balance"]
            },
            "description": "When rate limited (429), check Retry-After header tells you when to retry."
          }
        }
      ]
    },

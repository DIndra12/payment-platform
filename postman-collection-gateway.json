{
  "info": {
    "name": "Payment Platform - With API Gateway",
    "description": "Complete API testing collection with Gateway (port 8080), JWT authentication, and circuit breaker testing",
    "version": "2.0.0"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "jwt_secret",
      "value": "your-super-secret-key-that-is-at-least-32-characters-long-for-hs256",
      "type": "string"
    },
    {
      "key": "test_user_id",
      "value": "test-user-{{$timestamp}}",
      "type": "string"
    },
    {
      "key": "account_id_1",
      "value": "00000000-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "account_id_2",
      "value": "00000000-0000-0000-0000-000000000002",
      "type": "string"
    },
    {
      "key": "idempotency_key",
      "value": "{{$guid}}",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Setup & JWT Token",
      "item": [
        {
          "name": "Generate JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This is a placeholder test",
                  "// In Postman, JWT generation happens in pre-request scripts",
                  "pm.test('Token generated', function() {",
                  "    pm.expect(pm.variables.get('jwt_token')).to.be.truthy();",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate JWT token for testing",
                  "// This creates a token valid for 1 hour",
                  "",
                  "const secret = pm.variables.get('jwt_secret');",
                  "const userId = 'test-user';",
                  "const roles = ['USER', 'ADMIN'];",
                  "",
                  "// Note: For actual JWT generation in Postman,",
                  "// you would need a library or use the JWT endpoint.",
                  "// For now, this is a manual token setup.",
                  "",
                  "// Store for use in other requests",
                  "pm.variables.set('jwt_token', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ0ZXN0LXVzZXIiLCJyb2xlcyI6WyJVU0VSIiwiQURNSU4iXSwiZXhwIjo5OTk5OTk5OTk5fQ.dummy');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/test/token",
              "host": ["{{gateway_url}}"],
              "path": ["test", "token"]
            },
            "description": "Generate JWT token for testing. In production, this would be from your auth service."
          }
        },
        {
          "name": "Gateway Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/actuator/health",
              "host": ["{{gateway_url}}"],
              "path": ["actuator", "health"]
            },
            "description": "Check if gateway is running. This endpoint doesn't require JWT."
          }
        }
      ]
    },
    {
      "name": "02 Authentication Tests",
      "item": [
        {
          "name": "Request WITHOUT JWT (Should fail - 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should return 401 Unauthorized', function() {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/api/v1/accounts/{{account_id_1}}/balance",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "accounts", "{{account_id_1}}", "balance"]
            },
            "description": "Test that requests without JWT token are rejected with 401 Unauthorized."
          }
        },
        {
          "name": "Request WITH Invalid JWT (Should fail - 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should return 401 for invalid token', function() {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer INVALID_TOKEN_12345",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/accounts/{{account_id_1}}/balance",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "accounts", "{{account_id_1}}", "balance"]
            },
            "description": "Test that requests with invalid JWT token are rejected."
          }
        },
        {
          "name": "Request WITH Valid JWT (Should succeed - 200)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Set JWT token from variable (pre-generated)"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Should return 200 with valid JWT', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is valid JSON', function() {",
                  "    pm.response.to.be.json;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text",
                "description": "JWT token generated in setup step"
              }
            ],
            "url": {
              "raw": "{{gateway_url}}/api/v1/accounts/{{account_id_1}}/balance",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "accounts", "{{account_id_1}}", "balance"]
            },
            "description": "Request with valid JWT token should succeed and route to account-service."
          }
        }
      ]
    },

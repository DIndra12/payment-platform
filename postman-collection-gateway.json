            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerAccountId\": \"{{account_id_1}}\",\n  \"payeeAccountId\": \"{{account_id_2}}\",\n  \"amount\": 10.00,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/payments",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "payments"]
            },
            "description": "Normal payment when all services are healthy. Circuit breaker is CLOSED (allow requests)."
          }
        },
        {
          "name": "Payment When Account Service Down (Circuit OPEN)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Prerequisites: Account service must be stopped",
                  "// 1. Kill account-service process",
                  "// 2. Run this request",
                  "// 3. Payment service will fail to call account service",
                  "// 4. After 5 failures, circuit breaker opens",
                  "// 5. Returns error quickly (fail fast)"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response should be error (service unavailable)', function() {",
                  "    // When circuit is open, should get 5xx error quickly",
                  "    // instead of waiting for timeout",
                  "    pm.expect([500, 503]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerAccountId\": \"{{account_id_1}}\",\n  \"payeeAccountId\": \"{{account_id_2}}\",\n  \"amount\": 10.00,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/api/v1/payments",
              "host": ["{{gateway_url}}"],
              "path": ["api", "v1", "payments"]
            },
            "description": "Payment fails quickly when account service is down (circuit breaker OPEN). Fails fast instead of waiting for timeout."
          }
        },
        {
          "name": "Circuit Breaker State Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Response status is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Check circuit breaker metrics in response', function() {",
                  "    // Payment service exposes circuit breaker metrics",
                  "    // via /actuator/health",
                  "    pm.expect(pm.response.json()).to.have.property('status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{gateway_url}}/actuator/health",
              "host": ["{{gateway_url}}"],
              "path": ["actuator", "health"]
            },
            "description": "Check circuit breaker state via health endpoint. Shows if service is up or circuit is open."
          }
        }
      ]
    },
    {
      "name": "08 Transaction History (through Gateway)",
      "item": [
        {
          "name": "Get Transaction History",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [

              "listen": "test",
              "script": {
                "exec": [
                  "// Set collection variables for test accounts",
                  "pm.collectionVariables.set('payer_account_id', '11111111-1111-1111-1111-111111111111');",
                  "pm.collectionVariables.set('payee_account_id', '22222222-2222-2222-2222-222222222222');",
                  "pm.collectionVariables.set('payment_id', '');",
                  "",
                  "// Set base URLs",
                  "pm.collectionVariables.set('payment_service_url', 'http://localhost:8083');",
                  "pm.collectionVariables.set('account_service_url', 'http://localhost:8081');",
                  "pm.collectionVariables.set('fraud_service_url', 'http://localhost:8082');",
                  "pm.collectionVariables.set('notification_service_url', 'http://localhost:8084');",
                  "pm.collectionVariables.set('transaction_history_service_url', 'http://localhost:8085');",
                  "",
                  "console.log('✅ Test environment variables set successfully');",
                  "console.log('Payer Account: ' + pm.collectionVariables.get('payer_account_id'));",
                  "console.log('Payee Account: ' + pm.collectionVariables.get('payee_account_id'));"
                ]
              }
            }
          ],

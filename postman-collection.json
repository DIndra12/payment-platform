        {
          "name": "Create Payment - Idempotency Test (Same Key)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 202 Accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "pm.test('Response has same payment ID (idempotent)', function() {",
                  "    var jsonData = pm.response.json();",
                  "    var savedPaymentId = pm.collectionVariables.get('payment_id');",
                  "    pm.expect(jsonData.paymentId).to.equal(savedPaymentId);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Replay the happy-path request's key; the service must return the same payment",
                  "pm.collectionVariables.set('idempotency_key', pm.collectionVariables.get('happy_idempotency_key'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"

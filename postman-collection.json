        {
          "name": "Evaluate Risk - Low Amount (Should APPROVE)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('Risk evaluation response has required fields', function() {",
                  "    pm.expect(jsonData).to.have.property('riskScore');",
                  "    pm.expect(jsonData).to.have.property('decision');",
                  "    pm.expect(jsonData).to.have.property('reasons');",
                  "});",
                  "",
                  "pm.test('Low amount should result in APPROVE decision', function() {",
                  "    pm.expect(jsonData.decision).to.equal('APPROVE');",
                  "    pm.expect(jsonData.riskScore).to.be.below(50);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerAccountId\": \"{{payer_account_id}}\",\n  \"amount\": 500.00,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{fraud_service_url}}/api/v1/risk/evaluate",
              "host": [
                "{{fraud_service_url}}"

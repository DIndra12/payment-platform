                "v1",
                "risk",
                "evaluate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Evaluate Risk - High Amount (Should REJECT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.test('High amount should result in REJECT decision', function() {",
                  "    pm.expect(jsonData.decision).to.equal('REJECT');",
                  "    pm.expect(jsonData.riskScore).to.be.above(50);",
                  "});",
                  "",
                  "pm.test('Rejection should have reasons', function() {",
                  "    pm.expect(jsonData.reasons).to.be.an('array');",
                  "    pm.expect(jsonData.reasons.length).to.be.above(0);",
                  "});"
                ]
              }
            }

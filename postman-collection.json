        {
          "name": "Create Payment - Valid (Happy Path)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 202 Accepted', function() {",
                  "    pm.response.to.have.status(202);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('payment_id', jsonData.paymentId);",
                  "// Remember this key so the idempotency test can replay it",
                  "pm.collectionVariables.set('happy_idempotency_key', pm.collectionVariables.get('idempotency_key'));",
                  "",
                  "pm.test('Payment created successfully', function() {",
                  "    pm.expect(jsonData).to.have.property('paymentId');",
                  "    // The orchestrator runs synchronously, so a valid payment is usually already COMPLETED",
                  "    pm.expect(jsonData.status).to.be.oneOf(['INITIATED', 'RISK_CHECKED', 'DEBITED', 'CREDITED', 'COMPLETED']);",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generate unique idempotency key",
                  "var timestamp = new Date().getTime();",
                  "var randomString = Math.random().toString(36).substring(7);",
                  "var idempotencyKey = 'payment-' + timestamp + '-' + randomString;",
                  "pm.collectionVariables.set('idempotency_key', idempotencyKey);",
                  "console.log('Generated Idempotency Key: ' + idempotencyKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerAccountId\": \"{{payer_account_id}}\",\n  \"payeeAccountId\": \"{{payee_account_id}}\",\n  \"amount\": 100.00,\n  \"currency\": \"USD\"\n}"
            },
            "url": {
              "raw": "{{payment_service_url}}/api/v1/payments",
              "host": [
                "{{payment_service_url}}"
              ],
              "path": [
                "api",
                "v1",
                "payments"
              ]
            }
          },
          "response": []
        },
        {

    {
      "name": "End-to-End Workflows",
      "item": [
        {
          "name": "Complete Payment Flow",
          "item": [
            {
              "name": "Step 1 - Create Payment",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Payment created', function() {",
                      "    pm.response.to.have.status(202);",
                      "});",
                      "",
                      "var jsonData = pm.response.json();",
                      "pm.collectionVariables.set('e2e_payment_id', jsonData.paymentId);",
                      "console.log('Payment ID saved: ' + jsonData.paymentId);"
                    ]
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "var timestamp = new Date().getTime();",
                      "pm.collectionVariables.set('idempotency_key', 'e2e-flow-' + timestamp);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Idempotency-Key",
                    "value": "{{idempotency_key}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"payerAccountId\": \"{{payer_account_id}}\",\n  \"payeeAccountId\": \"{{payee_account_id}}\",\n  \"amount\": 500.00,\n  \"currency\": \"USD\"\n}"
                },
                "url": {
                  "raw": "{{payment_service_url}}/api/v1/payments",
                  "host": [
                    "{{payment_service_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "payments"
                  ]
                }
              }
            },
            {
              "name": "Step 2 - Check Payment Status (Wait 2s)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Payment status retrieved', function() {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "var jsonData = pm.response.json();",
                      "console.log('Payment Status: ' + jsonData.status);"
                    ]
                  }
                },
                {
                  "listen": "prerequest",
                  "script": {
                    "exec": [
                      "// Wait 2 seconds for async processing",
                      "var start = new Date().getTime();",
                      "while (new Date().getTime() - start < 2000) {}"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{payment_service_url}}/api/v1/payments/{{e2e_payment_id}}",
                  "host": [
                    "{{payment_service_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "payments",
                    "{{e2e_payment_id}}"
                  ]
                }
              }
            },
            {
              "name": "Step 3 - Check Transaction History",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Transaction history retrieved', function() {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "var jsonData = pm.response.json();",
                      "console.log('Total transactions: ' + jsonData.totalElements);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{transaction_history_service_url}}/api/v1/transactions/account/{{payer_account_id}}?page=0&size=5",
                  "host": [
                    "{{transaction_history_service_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "transactions",
                    "account",
                    "{{payer_account_id}}"
                  ],
                  "query": [
                    {
                      "key": "page",
                      "value": "0"
                    },
                    {
                      "key": "size",
                      "value": "5"
                    }
                  ]
                }
              }
            },
            {
              "name": "Step 4 - Verify Account Balances",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('Payer balance retrieved', function() {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "var jsonData = pm.response.json();",
                      "console.log('Payer Balance: ' + jsonData.balance);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{account_service_url}}/api/v1/accounts/{{payer_account_id}}/balance",
                  "host": [
                    "{{account_service_url}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "accounts",
                    "{{payer_account_id}}",
                    "balance"
                  ]
                }
              }
            }
          ]
        }
      ]

# Auto-detect text files and normalize line endings
* text=auto

# Java files - use LF
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.properties text eol=lf

# Windows batch files - use CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files - no conversion
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
